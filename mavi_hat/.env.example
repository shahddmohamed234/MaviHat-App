# MaviHat Environment Configuration Example
# Copy to .env for local configuration. Never commit real secrets or API keys.

APP_ENV=development
MAVIHAT_PROTOTYPE_MODE=true
MAVIHAT_DEFAULT_LOCALE=tr

# Firebase (Optional - falls back to Hive CE persistent sandbox repository when unconfigured)
FIREBASE_PROJECT_ID=mavihat-istanbul-demo
FIREBASE_API_KEY=demo_api_key_placeholder
FIREBASE_APP_ID=1:000000000000:android:0000000000000000

# Map Tile Configuration (OpenStreetMap standard tile server)
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_USER_AGENT_PACKAGE=tr.istanbul.mavihat.app

# Sandbox Payment & OTP Configuration
PAYMENT_GATEWAY_MODE=sandbox
OTP_DEV_TEST_CODE=123456

